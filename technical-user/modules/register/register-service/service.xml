<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.4.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_4_0.dtd">

<service-builder dependency-injector="ds" package-path="com.vass.register">
	<namespace>CUSTOMUSER</namespace>
	<entity local-service="true" name="CustomUser" remote-service="true" uuid="true">

		<!-- PK fields -->

		<column name="userId" primary="true" type="long" />

		<column name="name" type="String" />
		<column name="email" type="String" />

	</entity>
</service-builder>